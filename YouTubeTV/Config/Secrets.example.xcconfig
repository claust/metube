// Template for credentials. Copy this file to `Secrets.xcconfig` (which is gitignored) and
// fill in the values, then run `xcodegen generate`.
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// For a quick start you can use the well-known public YouTube-on-TV credentials (the same
// ones SmartTube and yt-dlp use); search "youtube tv oauth client id" or see the SmartTube
// project. The InnerTube API key is the public web key embedded in every youtube.com page.

YT_INNERTUBE_API_KEY = YOUR_INNERTUBE_API_KEY
YT_OAUTH_CLIENT_ID = YOUR_OAUTH_CLIENT_ID
YT_OAUTH_CLIENT_SECRET = YOUR_OAUTH_CLIENT_SECRET

// Your own Appwrite project, if you want watch progress backed up so it survives a reinstall
// — see Backend/README.md, which covers standing one up. Leave both empty and the app keeps
// progress on the device only; nothing is uploaded anywhere.
//
// The host only — no scheme, no path. `//` starts a comment in an xcconfig, so a full URL
// would silently truncate to "https:". HTTPS and Appwrite's /v1 are added by the app.
//
//   AP_HOST = appwrite.example.com
//   AP_PROJECT_ID = metube
//
AP_HOST =
AP_PROJECT_ID =

// Your Apple Developer team ID — only needed to build for a real Apple TV.
// It's the OU field of your signing certificate:
//   security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject
// NOTE: this is NOT the value in parentheses in `security find-identity` output — that's the
// certificate ID. Xcode also shows the team ID under Settings → Apple Accounts.
// Leave as-is for simulator-only builds; simulator builds don't code sign.
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Top Shelf on a real Apple TV needs the App Groups capability, which is only available to
// the paid Apple Developer Program — a free account cannot provision it, and a device build
// that asks for it fails to sign ("doesn't include the App Groups capability").
//
// Left empty, device builds skip the entitlement: the app installs and runs on the Apple TV,
// it just shows no Top Shelf tiles. The simulator always gets the entitlement regardless, so
// the feature is fully exercisable there. Once your team is in the paid program, set:
//
//   YT_DEVICE_ENTITLEMENTS = Config/AppGroup.entitlements
//
YT_DEVICE_ENTITLEMENTS =
