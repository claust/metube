# Copy to .testflight.env (gitignored) and fill in from App Store Connect →
# Users and Access → Integrations → App Store Connect API.
#
# The matching AuthKey_<ASC_KEY_ID>.p8 goes in ~/.private_keys/ — Apple lets you
# download it exactly once, and it is a credential: never commit it.
#
# The key must have the Admin role: cloud signing has to mint an Apple
# Distribution certificate, which only Admin and Account Holder may create.

ASC_KEY_ID=
ASC_ISSUER_ID=

# Apple Developer team. Normally left unset — DEVELOPMENT_TEAM in
# Config/Secrets.xcconfig is the single source of truth; this only overrides it.
# TV_TEAM=
